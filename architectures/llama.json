{
  "name": "llama",
  "tensor_mapping": {
    "token_embd": "model.embed_tokens.weight",
    "output": "lm_head.weight",
    "layers.{n}.attn_norm": "model.layers.{n}.input_layernorm.weight",
    "layers.{n}.attn_q": "model.layers.{n}.self_attn.q_proj.weight",
    "layers.{n}.attn_k": "model.layers.{n}.self_attn.k_proj.weight",
    "layers.{n}.attn_v": "model.layers.{n}.self_attn.v_proj.weight",
    "layers.{n}.attn_out": "model.layers.{n}.self_attn.o_proj.weight",
    "layers.{n}.ffn_norm": "model.layers.{n}.post_attention_layernorm.weight",
    "layers.{n}.ffn_gate": "model.layers.{n}.mlp.gate_proj.weight",
    "layers.{n}.ffn_up": "model.layers.{n}.mlp.up_proj.weight",
    "layers.{n}.ffn_down": "model.layers.{n}.mlp.down_proj.weight"
